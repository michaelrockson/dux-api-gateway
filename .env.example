LOG_LEVEL=
ENVIRONMENT=

# Infisical (required for runtime secrets)
INFISICAL_SITE_URL=https://app.infisical.com
INFISICAL_PROJECT_ID=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_ENVIRONMENT=dev

# Database (local dev / Prisma CLI only — sourced from Infisical at runtime)
DATABASE_URL=postgresql://user:password@localhost:5432/your_db

# Redis (store in Infisical for production)
REDIS_URL=redis://localhost:6379

WEATHER_API_KEY=
WEATHER_API_URL=

NEWS_API_KEY=
NEWS_API_URL=